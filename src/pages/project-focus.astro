---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentSection from '../components/ContentSection.astro';
import ProjectSections from '../components/ProjectSections.astro';
import { projectSections } from '../data/project';

const navigation = [
  ...projectSections,
  { id: 'references', title: 'References' },
];
---

<BaseLayout title="Project Focus | Team Polaris" page="focus">
  <main id="main" class="site-shell" tabindex="-1">
    <header class="page-intro focus-intro">
      <p class="eyebrow">Milestone 1 / A closer look</p>
      <h1>Project Focus</h1>
      <p class="intro-copy">A little more about the problem, the people, and the idea.</p>
    </header>
    <div class="focus-grid">
      <nav class="section-nav" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        {navigation.map(section => <a href={`#${section.id}`}>{section.title}</a>)}
      </nav>
      <div class="focus-content">
        <ProjectSections />
        <ContentSection id="references" title="References">
          <p class="eyebrow">Coming soon</p>
          <p>The sources we use will go here, with links back to them from the text above.</p>
        </ContentSection>
      </div>
    </div>
  </main>
</BaseLayout>
