---
interface Props {
  label?: string;
}

const { label = 'E-waste photo' } = Astro.props;
---

<figure class="feature-image">
  <div class="image-placeholder">
    <svg width="40" height="40" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="4" y="5" width="24" height="22" rx="4" />
      <circle cx="11" cy="12" r="2" />
      <path d="m5 23 7-7 5 5 4-5 6 7" />
    </svg>
    <span>{label}</span>
  </div>
  <figcaption>Image placeholder</figcaption>
</figure>
