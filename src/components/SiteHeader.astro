---
import BrandMark from './BrandMark.astro';

interface Props {
  page: 'overview' | 'focus';
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
const availablePages = [
  { id: 'overview', label: 'Overview', href: base },
  { id: 'focus', label: 'Project Focus', href: `${base}project-focus/` },
];
const upcomingPages = ['Contextual Inquiry', 'Persona', 'Lo-Fi Design', 'Hi-Fi Design', 'User Testing'];
---

<header class="site-header">
  <div class="site-shell header-inner">
    <a class="brand" href={base} aria-label="Polaris home"><BrandMark />Polaris</a>
    <nav aria-label="Main navigation">
      <ul class="site-nav">
        {availablePages.map(item => (
          <li><a class="site-nav-link" href={item.href} aria-current={page === item.id ? 'page' : undefined}>{item.label}</a></li>
        ))}
        {upcomingPages.map(label => (
          <li>
            <span class="site-nav-link site-nav-link--locked" role="link" aria-disabled="true" aria-label={`${label}, not yet available`} title="Available in a later milestone">
              {label}
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false">
                <rect x="3.5" y="7" width="9" height="7" rx="1.5" />
                <path d="M5.5 7V4.5a2.5 2.5 0 0 1 5 0V7M8 10v1.5" />
              </svg>
            </span>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
