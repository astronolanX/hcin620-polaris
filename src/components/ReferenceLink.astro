---
interface Props {
  id: number;
}

const { id } = Astro.props;
---

<sup class="reference-link"><a href={`#reference-${id}`} aria-label={`Reference ${id}`}>[{id}]</a></sup>

<style>
  .reference-link {
    margin-left: .15em;
    font-size: .68em;
    line-height: 0;
    white-space: nowrap;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
